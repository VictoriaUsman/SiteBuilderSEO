# AI Provider — set one or both
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=gemini  # gemini | openai

# WordPress — choose one auth method:

# Option A: WordPress.com (OAuth token)
WP_ACCESS_TOKEN=your_oauth_token_here
WP_SITE=allaroundph.wordpress.com

# Option B: Self-hosted WordPress.org (Application Password)
# WP_URL=https://yoursite.com
# WP_USERNAME=your_wp_username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Pexels API
PEXELS_API_KEY=your_pexels_api_key_here

# Content settings
MIN_WORD_COUNT=800
MAX_TITLE_LENGTH=60
MAX_META_LENGTH=160

# Concurrency
MAX_CONCURRENT_PAGES=10
